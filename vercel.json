{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "regions": ["pdx1"],
  "functions": {
    "app/api/cron/wix-contacts-sync/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/parts-canada-sync/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/weekly-shop-report/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/scan-mail/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/staff-feedback-squash/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/parts-canada-sync",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/wix-contacts-sync",
      "schedule": "*/4 * * * *"
    },
    {
      "path": "/api/cron/weekly-shop-report",
      "schedule": "0 0,1 * * 6"
    },
    {
      "path": "/api/cron/scan-mail",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/staff-feedback-squash",
      "schedule": "0 3,4 * * *"
    }
  ]
}
